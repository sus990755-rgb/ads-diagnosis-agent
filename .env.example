# LLM 配置（三家均为 OpenAI 兼容端点，按评测阶段选一组填入下方三个键）
# 型号均已对照官方价格页核实（2026-10-12），详见 MODEL_ROUTING.md 第 0 节
#
# 阶段 1 - 冒烟迭代（免费兜底）：智谱 glm-4.7-flash（永久免费，1 并发）
#   OPENAI_API_KEY=<智谱 API Key>
#   OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   MODEL_NAME=glm-4.7-flash
#
# 阶段 2 - 全量里程碑评测（主力工作马）：DeepSeek deepseek-v4-flash（付费，不限流，闲时半价）
#   OPENAI_API_KEY=<DeepSeek API Key>
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   MODEL_NAME=deepseek-v4-flash
#
# 阶段 3 - 最终定稿报告：Moonshot kimi-k2.6（指令遵循最强）
#   OPENAI_API_KEY=<Moonshot API Key>
#   OPENAI_BASE_URL=https://api.moonshot.cn/v1
#   MODEL_NAME=kimi-k2.6

OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# Feishu group bot push（留空则报告保存到本地 reports/ 目录）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
